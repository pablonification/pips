# A development setup. Copy it to `.env` in this folder (Git ignores `.env`) and change the lines marked CHANGE.
# Production's settings are in DEPLOY.md at the repository root; never put a real secret in a file Git tracks.

# `development` turns on the API page at /swagger and /doc and allows test login. Anything other than `development`
# or `staging` counts as production, where both stay off. NODE_ENV=production also starts the calendar reminder job.
APP_ENV=development
NODE_ENV=development

# The web dev server sends /api to port 5000. On a Mac, AirPlay owns 5000: use 5100 here and start the web app with
# DEV_API_ORIGIN=http://127.0.0.1:5100 (see CONTRIBUTING.md).
PORT=5000

# CHANGE the user, password and port to your local PostgreSQL (CONTRIBUTING.md, "First run").
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/pips

# The web app's address, as a JSON list.
ALLOWED_ORIGINS=["http://localhost:5173"]

# Sessions. CHANGE JWT_SECRET: `node -e 'console.log(require("crypto").randomBytes(32).toString("hex"))'`.
# TOKEN_EXPIRATION is a number of seconds (2592000 is 30 days), never "30d".
JWT_SECRET=change-me
TOKEN_EXPIRATION=2592000

# Test login: the way to sign in without Google. Only works with APP_ENV=development. CHANGE the hash. It is
# `salt:hex(scrypt(password, salt, 32))`; make one with
#   node -e 'const c=require("crypto"),s=c.randomBytes(16).toString("hex");console.log(s+":"+c.scryptSync(process.argv[1],s,32).toString("hex"))' 'your-password'
# The first sign-in creates one member from DEV_LOGIN_EMAIL (see CONTRIBUTING.md).
ENABLE_TEST_LOGIN=true
DEV_LOGIN_EMAIL=dev@hmif.test
DEV_LOGIN_PASSWORD_HASH=

# Web push needs a real key pair, even if you never send one. CHANGE both:
#   pnpm --filter api exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=dev@example.com

# The API insists on these although development never uses them. Leave the placeholders.
GOOGLE_CLIENT_ID=unused
GOOGLE_CLIENT_SECRET=unused
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
SMTP_HOST=unused
SMTP_PORT=587
SMTP_PASS=unused
# File storage. Both must be real-looking addresses or the API refuses to start; uploads fail until they are real.
R2_ENDPOINT=http://localhost:9
R2_PUBLIC_URL=http://localhost:9

# Only for a real deployment (DEPLOY.md explains each):
# CLIENT_IP_HEADER=cf-connecting-ip
# GOOGLE_ALLOWED_CLIENT_IDS=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# SENTRY_DSN=
# DB_STATEMENT_TIMEOUT_MS=15000
# RENOTIFY_DIFF_HOURS=3
# LISTEN_HOST=127.0.0.1
