# Listen address; leave unset in containers. The shared staging host uses 127.0.0.1.
# LISTEN_HOST=127.0.0.1
PORT=5000
# Where the rate limits read the client's address: x-forwarded-for (default: its right-most entry, the one the
# nearest proxy appended), cf-connecting-ip (only when the API is reachable through Cloudflare alone, as behind a
# Cloudflare tunnel) or none (the connection's own address, nothing in front). Behind Cloudflare, a proxy's right-most
# entry is Cloudflare's own address, so set cf-connecting-ip there.
# CLIENT_IP_HEADER=x-forwarded-for
DATABASE_URL="postgresql://postgres:root@localhost/hmif"
ALLOWED_ORIGINS='["http://localhost:5173"]'
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_MAILTO=example@gmail.com
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secer
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Kalender's Google service-account key (a JSON file, absolute path). Without it Kalender's changes fail.
GOOGLE_CALENDAR_SECRET_PATH=/path/to/google_credentials.json
R2_ENDPOINT=https://your_r2_endpoint.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_PUBLIC_URL=https://your_r2_public_url.com
R2_BUCKET_NAME=your_r2_bucket_name
JWT_SECRET=your_jwt_secret
TOKEN_EXPIRATION=2592000
# Staging or development only, at least 32 characters (the route is off otherwise, and always off in production).
# LOGIN_BYPASS_KEY=
SENTRY_DSN=
RENOTIFY_DIFF_HOURS=3
# Test login requires APP_ENV=development or staging, ENABLE_TEST_LOGIN=true, and both credentials.
NODE_ENV=production
APP_ENV=production
ENABLE_TEST_LOGIN=false
# DEV_LOGIN_EMAIL=dev@hmif.test
# DEV_LOGIN_PASSWORD_HASH=<scrypt salt>:<64-character hex digest>
