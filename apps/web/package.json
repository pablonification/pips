{
  "name": "web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "api": "pnpm --dir ../api run --silent openapi ../web/node_modules/.cache/pips/openapi.json && openapi --input node_modules/.cache/pips/openapi.json --output src/api/generated --indent 2 --useUnionTypes --useOptions --name ApiClient",
    "api-staging": "openapi --input https://api.app-staging.hmif.dev/doc --output src/api/generated --indent 2 --useUnionTypes --useOptions --name ApiClient",
    "dev": "vite",
    "build": "tsc && vite build && node delete-sourcemap.js",
    "lint": "eslint .",
    "lint:debug": "eslint ./src --debug",
    "lint:fix": "eslint ./src --fix",
    "preview": "vite preview",
    "check": "pnpm run typecheck && pnpm run lint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e && tsc --noEmit -p tests",
    "test": "node --test tests/*.test.mjs && tsx --test tests/*.test.ts",
    "budgets": "node scripts/budgets.mjs",
    "e2e": "playwright test -c e2e --project=phone-light --project=phone-dark --project=tablet-light --project=tablet-dark --project=desktop-light --project=desktop-dark --project=visual-phone-light --project=visual-phone-dark --project=visual-desktop-light --project=visual-desktop-dark --pass-with-no-tests",
    "e2e:before": "node e2e/scripts/before.mjs",
    "e2e:compare-before": "node e2e/scripts/compare-before.mjs",
    "fidelity": "node e2e/scripts/fidelity.mjs",
    "fidelity:compare": "node e2e/scripts/compare-runs.mjs",
    "e2e:update": "playwright test -c e2e --project=visual-phone-light --project=visual-phone-dark --project=visual-desktop-light --project=visual-desktop-dark --update-snapshots --pass-with-no-tests"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.2.0",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-popover": "^1.0.7",
    "@radix-ui/react-radio-group": "^1.1.3",
    "@radix-ui/react-select": "^2.1.1",
    "@radix-ui/react-separator": "^1.0.3",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.0.3",
    "@radix-ui/react-toggle": "^1.0.3",
    "@react-oauth/google": "^0.12.1",
    "@sentry/react": "^8.9.2",
    "@sentry/vite-plugin": "^2.23.1",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@tanstack/react-query-persist-client": "^5.104.2",
    "@tanstack/react-router": "^1.170.42",
    "@tanstack/router-devtools": "^1.167.2",
    "bungkus": "^1.3.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^1.0.0",
    "dayjs": "^1.11.11",
    "embla-carousel-react": "^8.1.3",
    "framer-motion": "^11.3.21",
    "idb": "^8.0.0",
    "markdown-to-jsx": "^7.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^4.0.13",
    "react-hook-form": "^7.51.3",
    "react-hot-toast": "^2.4.1",
    "react-intersection-observer": "^9.10.3",
    "react-webcam": "^7.2.0",
    "recharts": "^3.10.1",
    "socket.io-client": "^4.8.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "vite-plugin-radar": "^0.11.0",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1",
    "zod": "^3.23.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/archivo": "5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.43",
    "@types/node": "^22.19.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-tailwindcss": "^4.4.0",
    "geist": "1.7.2",
    "globals": "^17.13.0",
    "openapi-typescript-codegen": "^0.28.0",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1"
  }
}
