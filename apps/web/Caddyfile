# The web image's server. Paths that aren't files of the build get index.html (the app's own routes and legacy
# redirects); a missing script, style or other file answers 404, never the app's page. Every response is
# revalidated, so a browser never keeps an index.html whose hashed scripts a newer deploy has removed.
:3000 {
	root * /srv
	encode zstd gzip
	header Cache-Control "public, max-age=0, must-revalidate"
	header X-Content-Type-Options "nosniff"
	header Referrer-Policy "strict-origin-when-cross-origin"
	header X-Frame-Options "DENY"
	# Content-Security-Policy-Report-Only, written by the Dockerfile (scripts/csp.mjs). Enforce it only after a real
	# Google sign-in, an upload, a post with a picture and an open Curhat room on staging leave no report in the
	# browser's console.
	import /etc/caddy/csp.caddy
	# Search engines list only production's sign-in page and /, which sends there. Every other page is a member's, and
	# staging, a preview or the image on another address is never listed. SITE_HOST is production's address.
	@noindex {
		not path /assets/*
		not path_regexp \.[^/]*$
		not {
			host {$SITE_HOST:app.hmif.dev}
			path / /login
		}
	}
	header @noindex X-Robots-Tag "noindex, nofollow"
	# LINE shows a link's picture as a small square, which would crop the wide one, so its crawler (line-poker in its
	# user agent) gets the same head with the HMIF logo as the picture. Only its crawler, never LINE's in-app browser.
	@linePreview {
		header_regexp User-Agent (?i)line-poker
		not path /assets/*
		not path_regexp \.[^/]*$
	}
	rewrite @linePreview /preview-square.html
	header /preview-square.html X-Robots-Tag "noindex, nofollow"
	@app {
		not header_regexp User-Agent (?i)line-poker
		not path /assets/*
		not path_regexp \.[^/]*$
		not file
	}
	rewrite @app /index.html
	file_server
}
