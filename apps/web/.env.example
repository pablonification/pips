# The web app's settings. For a first run, copy this file to `.env.local` in this folder (Git ignores it); only
# VITE_GOOGLE_CLIENT_ID is needed. Every value here ends up in the app people download, so none of them is a secret.
# `.env.development` already turns on the test-login form for `pnpm --filter web dev`.

# Needed: the sign-in page fails to load without it ("Bagian ini gagal dimuat"). Any value works on your machine;
# Google's button then does nothing, and you sign in another way (CONTRIBUTING.md, "First run").
VITE_GOOGLE_CLIENT_ID=unused.apps.googleusercontent.com

# Optional. Where the API is. Empty means the app's own address: the dev server passes /api and /socket.io to the API
# (DEV_API_ORIGIN, default http://127.0.0.1:5000). A deployment sets the API's address, for example
# https://app-api.hmif.dev.
VITE_API_URL=

# Optional. The web-push public key, the API's VAPID_PUBLIC_KEY. Without it, turning notifications on fails.
VITE_VAPID_KEY=

# Optional. The file storage's public address, the API's R2_PUBLIC_URL. A SPARTA file answer becomes a link only when it
# points there.
VITE_MEDIA_URL=

# Optional, for a deployment: error reports (Sentry), analytics, and the installed app's name (default PIPS!).
VITE_SENTRY_DSN=
VITE_ANALYTICS_ID=
VITE_APP_NAME=PIPS!
