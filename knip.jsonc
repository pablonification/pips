{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  // An export used only inside its own file is fine; only an export nothing imports is reported.
  "ignoreExportsUsedInFile": true,
  "ignoreIssues": {
    // The reliability test loads this module with a dynamic import() after setting its environment, which knip can't follow.
    "apps/api/src/repositories/calendar.repo.ts": ["exports"]
  },
  // Generated by `pnpm --filter web api`; whole client, most of it unused on purpose.
  "ignore": ["apps/web/src/api/generated/**"],
  "workspaces": {
    ".": { "entry": ["scripts/*.mjs"] },
    "apps/web": {
      "entry": ["src/sw.ts", "src/routes/**/*.{ts,tsx}", "scripts/**/*.{mjs,ts}", "tests/**/*.test.{ts,mjs}", "e2e/**/*.spec.ts", "e2e/scripts/*.{mjs,ts}", "e2e/playwright.config.ts", "e2e/vite.e2e.config.ts", "eslint-rules/**/*.{js,mjs}"],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.{ts,mjs}", "tests/**/*.{ts,mjs}", "scripts/**/*.{ts,mjs}", "eslint-rules/**/*.{js,mjs}"],
      // Read by scripts/fonts/build-fonts.py (the self-hosted font files), not by any import.
      "ignoreDependencies": ["geist", "@fontsource-variable/archivo"]
    },
    "apps/api": {
      "entry": ["scripts/*.ts", "tests/**/*.test.ts"],
      "project": ["src/**/*.ts", "tests/**/*.ts", "scripts/**/*.ts"],
      // A peer dependency of @typescript-eslint/eslint-plugin; nothing imports it.
      "ignoreDependencies": ["@typescript-eslint/parser"]
    }
  }
}
